# ================================================================
# انسخ الملف ده باسم .env وغيّر كل القيم اللي فيها CHANGE_ME
# ملف .env ممنوع يترفع على الإنترنت أو يتبعت لحد (متسجل في .gitignore)
# ================================================================
NODE_ENV=development
PORT=3000

# حساب السيرفر العادي (صلاحيات محدودة) — كلمة السر ١٦ حرف على الأقل
DATABASE_URL=postgres://dm_app:CHANGE_ME_app_password_long@localhost:5432/delivery
# حساب المالك: بيستخدم بس لإنشاء الجداول
MIGRATION_DATABASE_URL=postgres://postgres:CHANGE_ME_owner_password@localhost:5432/delivery

REDIS_URL=redis://localhost:6379

# اعمل قيم عشوائية بالأمر:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_run_the_command_above_and_paste_result
DATA_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_from_the_same_command_above_xxxxxxxxxxxxxx

# عناوين الواجهات المسموح لها تكلم السيرفر (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:5173

# console = الكود بيظهر في شاشة السيرفر (للتجربة بس)
SMS_PROVIDER=console

# لو السيرفر ورا بروكسي (زي Caddy) خليها 1
TRUST_PROXY=0
