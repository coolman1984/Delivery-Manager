# ================================================================
# إعدادات السيرفر. الأسهل: شغّل  pnpm setup:env  وهو هيعمل ملف .env بقيم عشوائية آمنة.
# ملف .env ممنوع يترفع على الإنترنت أو يتبعت لحد (متسجل في .gitignore).
# السيرفر بيرفض يشتغل لو أي قيمة لسه فيها CHANGE_ME.
# ================================================================
NODE_ENV=development
PORT=3000

# حساب السيرفر العادي (صلاحيات محدودة) — كلمة السر ١٦ حرف على الأقل
DATABASE_URL=postgres://dm_app:CHANGE_ME@localhost:5432/delivery
# حساب المالك: بيستخدم بس لإنشاء الجداول (نفس كلمة السر اللي في docker-compose.dev.yml)
MIGRATION_DATABASE_URL=postgres://postgres:dev_owner_password@localhost:5432/delivery

REDIS_URL=redis://localhost:6379

# مفاتيح عشوائية (٦٤ حرف). اعملها بالأمر:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME

# عناوين الواجهات المسموح لها تكلم السيرفر (مفصولة بفاصلة)
CORS_ORIGINS=http://localhost:5173

# الدخول بكود على الموبايل (مقفول لحد ما نتعاقد مع شركة رسائل)
OTP_ENABLED=false
# console = الكود بيظهر على الشاشة (للتجربة بس)
SMS_PROVIDER=console

# لو السيرفر ورا بروكسي (زي Caddy) خليها 1
TRUST_PROXY=0

# إشعارات الموبايل (اختياري): npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
