# ================================================================
# إعدادات السيرفر الحقيقي (انسخه باسم .env على السيرفر بجوار docker-compose.yml)
# كل قيمة CHANGE_ME لازم تتغير. اعمل كل مفتاح بالأمر:
#   openssl rand -hex 32
# ================================================================
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
PLATFORM_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
# كلمة سر تشفير النسخ الاحتياطية — احفظها في مكان آمن بره السيرفر! من غيرها النسخ مالهاش لازمة
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_KEEP_DAYS=14

# العنوان الأساسي: كل شركة بتشتغل على  اسمها.العنوان  (مثلاً beni-suef.example.com)
# محتاج في إعدادات الدومين سجل  *.example.com  يشاور على السيرفر، وشهادات الأمان بتطلع لوحدها
BASE_DOMAIN=example.com
# عنوان لوحة مالك المنصة (مش هتفتح من أي عنوان تاني)
PLATFORM_HOST=admin.example.com
# إيميل بيوصله تنبيهات شهادات الأمان
ACME_EMAIL=you@example.com
# أيام السماح بعد انتهاء اشتراك الشركة قبل ما تتوقف لوحدها
SUBSCRIPTION_GRACE_DAYS=3

# الدخول بكود على الموبايل مقفول لحد ما نتعاقد مع شركة رسائل.
# وهو مقفول: العملاء بيسجلوا بالموبايل وكلمة سر.
OTP_ENABLED=false
SMS_PROVIDER=console

# إشعارات الموبايل (اختياري): اعمل المفتاحين بالأمر  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
