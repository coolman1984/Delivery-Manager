# ================================================================
# إعدادات السيرفر الحقيقي (انسخه باسم .env على السيرفر بجوار docker-compose.yml)
# كل قيمة CHANGE_ME لازم تتغير. اعمل كل مفتاح بالأمر:
#   openssl rand -hex 32
# ================================================================
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
# كلمة سر تشفير النسخ الاحتياطية — احفظها في مكان آمن بره السيرفر! من غيرها النسخ مالهاش لازمة
BACKUP_PASSPHRASE=CHANGE_ME
BACKUP_KEEP_DAYS=14

# عناوين الشركات (كل شركة ليها عنوان فرعي)
DOMAINS=beni-suef.example.com, fayoum.example.com
CORS_ORIGINS=https://beni-suef.example.com,https://fayoum.example.com

# الدخول بكود على الموبايل مقفول لحد ما نتعاقد مع شركة رسائل.
# وهو مقفول: العملاء بيسجلوا بالموبايل وكلمة سر.
OTP_ENABLED=false
SMS_PROVIDER=console
