{
  "name": "@dm/shared",
  "version": "0.1.0",
  "private": true,
  "description": "الحاجات المشتركة بين السيرفر والواجهات: قواعد الفحص، حالات الطلب، حسابات الفلوس",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/schemas.d.mts",
        "default": "./dist/schemas.mjs"
      },
      "require": {
        "types": "./dist/schemas.d.ts",
        "default": "./dist/schemas.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schemas.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/schemas.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ]
}
